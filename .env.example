# Google Sheets (server-only)
GOOGLE_SHEET_ID=replace_with_the_id_between_d_and_edit_in_the_sheet_url
GOOGLE_SHEET_NAME=Consultation Enquiries
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=service-account-name@project-id.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key\n-----END PRIVATE KEY-----\n"

# Brevo transactional email (server-only)
BREVO_API_KEY=replace_with_brevo_api_key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Digital Saugat Website

# Set this to the real deployed origin, without a trailing slash.
# It enables strict same-origin checks for form submissions.
SITE_URL=https://your-real-production-domain.example
